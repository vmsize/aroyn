do
assert(Mock.connections==0)
local E=libraryEnvironment;local U=E.UDim2
local A=makeLibrary();local parent=Mock.Instance.new('PlayerGui')
local W=A:CreateWindow({Parent=parent,Id='keybind-tests',Size=U.fromOffset(680,440)})
local P=W:CreatePage({Name='Controls'});local S=P:CreateSection({Title='Keybinds'})
local changes,activations={},{}
local function active(value,key,mode) table.insert(activations,{value,key,mode}) end
local toggle=S:CreateKeybind({Name='Toggle',Default='H',Mode='Toggle',Callback=function(key) table.insert(changes,key and key.Name or 'None') end,OnActivate=active})
local hold=S:CreateKeybind({Name='Hold',Default=Mock.Enum.KeyCode.J,Mode='Hold',OnActivate=active})
local always=S:CreateKeybind({Name='Always',Mode='Always',OnActivate=active})
local disabled=S:CreateKeybind({Name='Disabled',Default='K',Disabled=true,OnActivate=active})
assert(toggle:GetValue()==Mock.Enum.KeyCode.H and toggle:GetMode()=='Toggle' and not toggle:GetActive())
assert(always:GetActive() and #changes==0 and #activations==0)
local function begin(key,processed) local input=Mock.key(key);Mock.input.InputBegan:Fire(input,processed==true);return input end
local function release(input) Mock.input.InputEnded:Fire(input) end
local function tap(key,processed) local input=begin(key,processed);release(input) end
tap('H');assert(toggle:GetActive() and #activations==1)
local key=begin('H');Mock.input.InputBegan:Fire(key,false);assert(not toggle:GetActive() and #activations==2)
release(key);tap('H');assert(toggle:GetActive() and #activations==3)
tap('K');assert(not disabled:GetActive() and #activations==3)
local current=#activations;key=begin('J');assert(hold:GetActive() and #activations==current+1)
Mock.input.InputBegan:Fire(key,false);assert(#activations==current+1)
release(key);assert(not hold:GetActive() and #activations==current+2)
tap('J',true);assert(not hold:GetActive() and #activations==current+2)
pass('Keybind Toggle/Hold/Always defaults, repeat suppression, release, processed input and disabled activation semantics')
assert(toggle:BeginCapture() and toggle:IsCapturing())
assert(toggle.KeyLabel.Text=='Press a key...')
current=#activations;key=begin('J');assert(toggle:GetValue()==Mock.Enum.KeyCode.J and not toggle:IsCapturing())
assert(not hold:GetActive() and #changes==1 and #activations==current+1) -- Toggle deactivation on rebinding only.
release(key);tap('J');assert(toggle:GetActive() and not hold:GetActive())
local value=toggle:GetValue();toggle:BeginCapture();tap('Escape')
assert(toggle:GetValue()==value and not toggle:IsCapturing() and #changes==1)
toggle:BeginCapture();tap('Backspace');assert(toggle:GetValue()==nil and changes[2]=='None')
toggle:SetValue('H');toggle:BeginCapture();tap('Delete');assert(toggle:GetValue()==nil and #changes==3)
toggle:SetValue('H');local count=#changes
local _,valid=toggle:SetValue('NoSuchKey',true);assert(not valid and toggle:GetValue()==Mock.Enum.KeyCode.H)
_,valid=toggle:SetValue(Mock.Enum.UserInputType.MouseButton1,true);assert(not valid)
_,valid=toggle:SetValue('ButtonA',true);assert(not valid)
toggle:BeginCapture();tap('Unknown');assert(toggle:IsCapturing() and toggle.KeyLabel.Text=='Unsupported key')
tap('F');assert(toggle:GetValue()==Mock.Enum.KeyCode.F and #changes==count+1)
toggle:SetValue('F',true);assert(#changes==count+1)
toggle:SetValue(nil);assert(toggle:GetValue()==nil and #changes==count+1)
pass('Key capture assigns without activation, Escape cancels, Backspace/Delete clear, invalid setters preserve state, changed callbacks deduplicate')
toggle:BeginCapture();assert(toggle:IsCapturing());hold:BeginCapture()
assert(hold:IsCapturing() and not toggle:IsCapturing())
tap('K');assert(hold:GetValue()==Mock.Enum.KeyCode.K and not disabled:GetActive())
key=begin('K');assert(hold:GetActive())
local box=Mock.Instance.new('TextBox');box.Parent=S.Root;box:CaptureFocus()
assert(not hold:GetActive());release(key)
toggle:SetValue('H');current=#activations;tap('H');assert(not toggle:GetActive() and #activations==current)
assert(not toggle:BeginCapture());box:ReleaseFocus(false)
toggle:BeginCapture();box:CaptureFocus();assert(not toggle:IsCapturing());box:ReleaseFocus(false)
key=begin('K');assert(hold:GetActive());Mock.input.WindowFocusReleased:Fire()
assert(not hold:GetActive() and not always:GetActive());release(key)
tap('H');assert(not toggle:GetActive());Mock.input.WindowFocused:Fire();assert(always:GetActive())
tap('H');assert(toggle:GetActive())
toggle:SetDisabled(true);assert(not toggle:GetActive() and not toggle:BeginCapture())
toggle:SetDisabled(false);tap('H');assert(toggle:GetActive())
pass('Exclusive rebinding, TextBox focus, focus loss/return and disable/re-enable safely release activation without duplicate callbacks')
toggle:BeginCapture();P.Root.Visible=false
assert(not toggle:IsCapturing() and not toggle:GetActive() and not always:GetActive())
P.Root.Visible=true;assert(always:GetActive())
W.OwnRoot.Enabled=false;assert(not always:GetActive());W.OwnRoot.Enabled=true;assert(always:GetActive())
Mock.input.KeyboardEnabled=false;Mock.input:GetPropertyChangedSignal('KeyboardEnabled'):Fire()
assert(toggle.KeyLabel.Text=='Keyboard required' and not toggle:BeginCapture())
Mock.input.KeyboardEnabled=true;Mock.input:GetPropertyChangedSignal('KeyboardEnabled'):Fire()
assert(toggle.KeyLabel.Text=='H')
W:SetMinimized(true);assert(not always:GetActive());W:SetMinimized(false);Mock.advance(1)
assert(always:GetActive())
toggle:BeginCapture();toggle:Destroy();tap('F')
assert(not toggle.Scope.Alive and not hold:IsCapturing())
local before=#activations
W:Destroy();Mock.advance(1);local after=#activations;tap('J');assert(#activations==after and after>=before)
assert(Mock.connections==0 and #parent:GetChildren()==0)
pass('Visibility, ScreenGui, keyboard-less mobile, minimize and destruction release capture/Always and remove the shared input hub')
local A2=makeLibrary();local W2=A2:CreateWindow({Parent=parent,Id='keybind-callback',Size=U.fromOffset(680,440)})
local S2=W2:CreatePage({Name='Test'}):CreateSection({Title='Keys'})
local dying=S2:CreateKeybind({Name='Destroy on activation',Default='H',OnActivate=function() W2:Destroy() end})
tap('H');assert(not dying.Scope.Alive and Mock.connections==0)
local W3=A2:CreateWindow({Parent=parent,Id='keybind-invalid',Size=U.fromOffset(680,440)})
local S3=W3:CreatePage({Name='Test'}):CreateSection({Title='Keys'});local connections=Mock.connections;local children=#S3.Root:GetChildren()
for _,spec in ipairs({{Name='Bad',Default='Missing'},{Name='Bad',Default='Escape'},{Name='Bad',Mode='Bad'},{Name='Bad',Mode=false},{Name='Bad',OnActivate=2}}) do
    assert(not pcall(function() S3:CreateKeybind(spec) end));assert(Mock.connections==connections and #S3.Root:GetChildren()==children)
end
local bad=S3:CreateKeybind({Name='Protected callback',Default='H',OnActivate=function() error('expected callback error') end})
local warnings=#Mock.warnings;tap('H');assert(bad:GetActive() and #Mock.warnings==warnings+1)
W3:Destroy();Mock.advance(1);assert(Mock.connections==0)
pass('Keybind rejects invalid construction before allocation and isolates error/destruction callbacks with complete cleanup')
end
