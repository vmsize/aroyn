-- Executed by verify.py with the independent module, after old GUI cleanup.
assert(Mock.connections==0)
local Aroyn=makeLibrary()
local parent=Mock.Instance.new('PlayerGui')
local W=Aroyn:CreateWindow({Parent=parent,Id='components-test',Title='AROYN',Size=libraryEnvironment.UDim2.fromOffset(680,440)})
local P=W:CreatePage({Name='General',Icon='settings'})
local S=P:CreateSection({Title='Controls'})
local events={toggle=0,button=0,enter=0,blur=0}
local toggle=S:CreateToggle({Name='Auto example',Description='Local only',Default=true,Callback=function(v) events.toggle+=1;events.toggleValue=v end})
assert(toggle:GetValue() and events.toggle==0)
toggle.Control.Activated:Fire();assert(not toggle:GetValue() and events.toggle==1 and events.toggleValue==false)
toggle:SetValue(true);assert(toggle:GetValue() and events.toggle==1)
toggle:SetValue(true,true);assert(events.toggle==1)
toggle:SetValue(false,true);assert(events.toggle==2)
toggle:SetDisabled(true);toggle.Control.Activated:Fire();assert(not toggle:GetValue() and events.toggle==2)
assert(not toggle.Control.Active and toggle:IsDisabled())
toggle:SetDisabled(false);toggle.Control.Activated:Fire();assert(toggle:GetValue() and events.toggle==3)
assert(toggle.Thumb.Position.X.Offset==-(Aroyn.Theme.Metrics.Thumb+Aroyn.Theme.Metrics.ThumbInset))
pass('standalone Toggle defaults, changed-value callbacks, silent SetValue, disable and thumb bounds')
local primary=S:CreateButton({Name='Primary',Text='Run',Variant='Primary',Callback=function() events.button+=1 end})
local secondary=S:CreateButton({Name='Secondary',Callback=function() events.button+=1 end})
assert(primary.Control.BackgroundColor3.R>secondary.Control.BackgroundColor3.R)
primary.Control.MouseEnter:Fire();primary.Control.MouseButton1Down:Fire()
assert(primary.Pressed and events.button==0)
primary.Control.MouseButton1Up:Fire();primary.Control.Activated:Fire();assert(events.button==1)
primary:SetDisabled(true);primary.Control.Activated:Fire();assert(events.button==1)
primary.Control.MouseEnter:Fire();assert(not primary.Hovered)
primary:SetText('Updated');assert(primary.Control.Text=='Updated')
primary:SetDisabled(false);primary.Control.Activated:Fire();assert(events.button==2)
local warningCount=#Mock.warnings
local failing=S:CreateButton({Name='Failing example',Callback=function() error('expected test callback failure') end})
failing.Control.Activated:Fire();assert(#Mock.warnings==warningCount+1)
secondary.Control.Activated:Fire();assert(events.button==3 and W.Scope.Alive)
local before=Mock.connections
for _=1,100 do primary.Control.MouseEnter:Fire();primary.Control.MouseLeave:Fire() end
assert(Mock.connections==before)
pass('Button variants, press versus activation, disabled guards, callback error isolation and hover cleanup')
local input=S:CreateTextInput({Name='Enter',Default='initial',Placeholder='Example',Description='Submit with Enter',SubmitOnEnter=true,
    Callback=function(v) events.enter+=1;events.enterValue=v end})
assert(input:GetValue()=='initial' and events.enter==0)
input.Control:CaptureFocus();assert(input.Focused)
input.Control.Text='typed';input.Control:ReleaseFocus(false)
assert(input:GetValue()=='typed' and events.enter==0 and not input.Focused)
input.Control:CaptureFocus();input.Control:ReleaseFocus(true);assert(events.enter==1 and events.enterValue=='typed')
input:SetValue('silent');assert(input:GetValue()=='silent' and events.enter==1)
input:SetValue('notified',true);assert(events.enter==2)
input.Control:CaptureFocus();input:SetDisabled(true)
assert(not input.Control.TextEditable and not input.Control:IsFocused() and events.enter==2)
input.Control.FocusLost:Fire(true);assert(events.enter==2)
input:SetDisabled(false);assert(input.Control.TextEditable)
local blur=S:CreateTextInput({Name='Blur',Callback=function(v) events.blur+=1;events.blurValue=v end})
blur.Control:CaptureFocus();blur.Control.Text='left';blur.Control:ReleaseFocus(false)
assert(events.blur==1 and events.blurValue=='left')
pass('Text Input placeholder/default, Enter-only and blur submissions, programmatic values and disabled focus release')
assert(not pcall(function() S:CreateToggle({Name='Bad',Default='yes'}) end))
assert(not pcall(function() S:CreateTextInput({Name='Bad',Default=false}) end))
assert(not pcall(function() S:CreateButton({Name='Bad',Variant='Rainbow'}) end))
assert(not pcall(function() W:CreatePage({Name='General'}) end))
assert(not pcall(function() W:CreatePage({Name='Unknown',Icon='not-an-icon'}) end))
assert(not pcall(function() toggle:SetValue(1) end))
assert(not pcall(function() input:SetValue(false) end))
assert(not pcall(function() primary:SetDisabled('yes') end))
local Q=W:CreatePage({Name='Second',Icon='components'})
Q:Select();assert(Q.Root.Visible and not P.Root.Visible)
P:Select();assert(P.Root.Visible and not Q.Root.Visible)
P:Destroy();assert(W.Selected==Q and Q.Root.Visible and W.ByName.General==nil)
assert(not pcall(function() toggle:GetValue() end))
pass('API rejects invalid options/values and duplicate pages; page deletion selects a surviving page')
W.Minimize.Activated:Fire();assert(W.Minimized and not W.Root.Visible and W.Restore.Visible and W.Restore.Interactable)
local tap={UserInputType=Mock.Enum.UserInputType.Touch,Position=W.Restore.AbsolutePosition+libraryEnvironment.Vector2.new(24,24)}
W.Restore.InputBegan:Fire(tap);Mock.input.InputEnded:Fire(tap)
assert(not W.Minimized and W.Root.Visible and not W.Restore.Visible)
local header=W.Root:FindFirstChild('Header')
local position=W.Root.Position
local p=W.Root.AbsolutePosition
local v=libraryEnvironment.Vector2
local press={UserInputType=Mock.Enum.UserInputType.MouseButton1,Position=v.new(p.X+200,p.Y+20)}
header.InputBegan:Fire(press)
Mock.input.InputChanged:Fire({UserInputType=Mock.Enum.UserInputType.MouseMovement,Position=v.new(press.Position.X+30,press.Position.Y+24)})
Mock.input.InputEnded:Fire({UserInputType=Mock.Enum.UserInputType.MouseButton1})
assert(W.Root.Position.X.Offset==position.X.Offset+30 and W.Root.Position.Y.Offset==position.Y.Offset+24)
position=W.Root.Position
Mock.input.InputChanged:Fire({UserInputType=Mock.Enum.UserInputType.MouseMovement,Position=v.new(press.Position.X+60,press.Position.Y+48)})
assert(W.Root.Position.X.Offset==position.X.Offset and W.Root.Position.Y.Offset==position.Y.Offset)
local focus=Q:CreateSection({Title='Focus'}):CreateTextInput({Name='Focused'})
focus.Control:CaptureFocus();position=W.Root.Position
header.InputBegan:Fire(press)
Mock.input.InputChanged:Fire({UserInputType=Mock.Enum.UserInputType.MouseMovement,Position=v.new(press.Position.X+90,press.Position.Y+50)})
Mock.input.InputEnded:Fire(press)
assert(W.Root.Position.X.Offset==position.X.Offset and W.Root.Position.Y.Offset==position.Y.Offset)
focus.Control:ReleaseFocus(false)
pass('standalone window navigation, minimize/restore, header dragging and focused-input drag protection')
local replaced=Aroyn:CreateWindow({Parent=parent,Id='components-test'})
assert(not W.Scope.Alive and not W.OwnRoot.Parent)
assert(#parent:GetChildren()==1)
replaced:CreatePage({Name='New',Icon='cart'}):CreateSection({Title='Actions'}):CreateButton({Name='Destroy',Callback=function() replaced:Destroy() end}).Control.Activated:Fire()
replaced:Destroy();assert(#parent:GetChildren()==0 and Mock.connections==0)
local host=Mock.Instance.new('Frame');host.Parent=parent
local attach=Aroyn:AttachWindow({Root=host,Content=host,PageHeader=false})
attach:CreatePage({Name='First'}):CreateSection({Title='Attached'}):CreateToggle({Name='Toggle'})
local remount=Aroyn:AttachWindow({Root=host,Content=host})
assert(not attach.Scope.Alive and host.Parent==parent and #host:GetChildren()==0)
remount:CreatePage({Name='Second'})
host:Destroy();assert(not remount.Scope.Alive and Mock.connections==0)
assert(next(Aroyn.Mounts)==nil)
pass('same Id replaces only library windows; repeated attach, external destruction and callback destruction fully clean scopes')
local example=makeExample()
local sample=example(Aroyn,parent)
local controls=sample.Pages[1].Sections[1].Components
assert(not controls[1]:GetValue() and controls[2]:GetValue()=='Aroyn')
controls[3].Control.Activated:Fire()
assert(controls[1]:GetValue() and controls[2]:GetValue()=='Enabled')
sample:Destroy();assert(Mock.connections==0 and #parent:GetChildren()==0)
pass('documented basic example runs against the standalone module and cleans up')
